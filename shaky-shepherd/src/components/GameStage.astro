---
---
<section class="game-stage" id="game-stage" tabindex="-1" aria-label="Snake game board">
  <div class="board-corner corner-tl" aria-hidden="true"></div>
  <div class="board-corner corner-tr" aria-hidden="true"></div>
  <div class="board-corner corner-bl" aria-hidden="true"></div>
  <div class="board-corner corner-br" aria-hidden="true"></div>

  <canvas id="game-board" aria-label="Snake game board"></canvas>
  <span class="mode-badge" id="mode-badge" translate="no">CLASSIC</span>
  <div class="scanline" aria-hidden="true"></div>
  <div class="score-popups" id="score-popups" aria-hidden="true"></div>
  <div class="visually-hidden" id="status-announcer" role="status" aria-live="polite"></div>
  <div class="mission-toast" id="mission-toast" aria-hidden="true" hidden></div>
  <div class="mission-toast achievement-toast" id="achievement-toast" aria-hidden="true" hidden></div>
  <div class="event-banner" id="event-banner" aria-hidden="true" hidden></div>

  <div class="game-overlay" id="start-overlay">
    <div class="overlay-glow" aria-hidden="true"></div>
    <p class="eyebrow overlay-kicker" id="start-kicker">GET READY</p>
    <h2 class="display-tight" id="start-title">Ready to play?</h2>
    <p class="overlay-date" id="daily-date" hidden></p>
    <p class="overlay-text">
      Steer the snake with the arrow keys, WASD, or a swipe. Collect the fruit to grow.
    </p>
    <p class="overlay-note" id="start-mode-note">
      Standard Snake rules: eat fruit, grow, and don't hit the wall or your own tail.
    </p>
    <p class="overlay-mode-info" id="start-mode-info" translate="no"></p>
    <p class="overlay-rank" id="player-rank" translate="no"></p>
    <div class="missions-panel" id="missions-panel" translate="no" role="list" aria-label="Active missions">
      <span class="eyebrow missions-heading">MISSIONS</span>
      <div id="missions-list" class="missions-list"></div>
    </div>
    <div class="weekly-goals-panel" id="weekly-goals-panel" translate="no" role="list" aria-label="Weekly goals" hidden>
      <span class="eyebrow missions-heading">WEEKLY GOALS</span>
      <div id="weekly-goals-list" class="missions-list"></div>
    </div>
    <div class="daily-challenge-info" id="daily-challenge-info" hidden>
      <div class="daily-modifier" id="daily-modifier" aria-live="polite"></div>
      <div class="daily-progress">
        <span class="daily-progress-label">PROGRESS</span>
        <div class="daily-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="daily-progress-fill" id="daily-progress-fill"></span>
        </div>
        <span class="daily-progress-text" id="daily-progress-text">0 / 60</span>
      </div>
      <div class="daily-stats">
        <div class="daily-stat">
          <span class="daily-stat-label">BEST</span>
          <span class="daily-stat-value" id="daily-best-value">000</span>
        </div>
        <div class="daily-stat">
          <span class="daily-stat-label">YOUR BEST</span>
          <span class="daily-stat-value" id="daily-your-best">000</span>
        </div>
        <div class="daily-stat">
          <span class="daily-stat-label">STREAK</span>
          <span class="daily-stat-value" id="daily-streak-value">0 DAYS</span>
        </div>
      </div>
      <div class="streak-rewards" id="streak-rewards" hidden>
        <span class="eyebrow streak-rewards-heading">STREAK REWARDS</span>
        <div id="streak-rewards-list" class="streak-rewards-list"></div>
      </div>
      <div class="ghost-toggle" id="ghost-toggle" hidden>
        <label class="ghost-toggle-label">
          <input type="checkbox" id="ghost-toggle-input" aria-label="Show personal best ghost" />
          <span class="ghost-toggle-text">SHOW GHOST</span>
        </label>
      </div>
    </div>
    <p class="overlay-best" id="daily-best" hidden></p>
    <p class="overlay-streak" id="daily-streak" hidden></p>
    <button class="btn-pill btn-pill--primary" id="start-button">
      <span id="start-button-label">Start run</span><kbd class="keycap">Space</kbd>
    </button>
    <button class="btn-pill btn-pill--secondary start-fs-button" id="start-fullscreen-button" type="button">
      <span>Play fullscreen</span>
    </button>
    <p class="control-hint"><span>ARROW KEYS · WASD · SWIPE OR DIRECTION PAD</span></p>
  </div>

  <div class="game-overlay hidden" id="pause-overlay">
    <p class="eyebrow overlay-kicker">PAUSED</p>
    <h2 class="display-tight">Paused</h2>
    <p class="overlay-text">Take a breath — you can pick up right where you left off.</p>
    <button class="btn-pill btn-pill--primary" id="resume-button">
      <span>Resume run</span><kbd class="keycap">Space</kbd>
    </button>
  </div>

<div class="game-overlay hidden" id="gameover-overlay" role="dialog" aria-labelledby="gameover-title" aria-describedby="gameover-kicker">
    <p class="eyebrow overlay-kicker" id="gameover-kicker">RUN OVER</p>
    <h2 class="display-tight" id="gameover-title">You hit the wall.</h2>

    <div class="result-score">
      <span class="eyebrow result-score-label" translate="no">SCORE</span>
      <strong id="final-score" class="result-score-value">000</strong>
      <span class="result-new-best" id="new-best-badge" translate="no">NEW BEST</span>
    </div>

    <div class="challenge-section" id="challenge-section" hidden>
      <p class="eyebrow challenge-kicker" id="challenge-kicker">CHALLENGE</p>
      <h2 class="display-tight challenge-title" id="challenge-title"></h2>
      <p class="challenge-target" id="challenge-target" translate="no"></p>
      <p class="challenge-result" id="challenge-result"></p>
    </div>

    <dl class="result-grid" aria-label="Run results">
      <div class="result-item">
        <dt translate="no">BEST</dt>
        <dd id="final-best">000</dd>
      </div>
      <div class="result-item">
        <dt translate="no">LEVEL</dt>
        <dd id="final-level">01</dd>
      </div>
      <div class="result-item">
        <dt translate="no">LENGTH</dt>
        <dd id="final-length">4</dd>
      </div>
      <div class="result-item">
        <dt translate="no">LONGEST</dt>
        <dd id="final-longest">4</dd>
      </div>
      <div class="result-item">
        <dt translate="no">FRUIT</dt>
        <dd id="final-fruit">0</dd>
      </div>
      <div class="result-item">
        <dt translate="no">TIME</dt>
        <dd id="final-duration">0:00</dd>
      </div>
      <div class="result-item result-item--wide">
        <dt translate="no">BEST LENGTH</dt>
        <dd id="final-record">4</dd>
      </div>
      <div class="result-item result-item--wide">
        <dt translate="no">XP EARNED</dt>
        <dd id="final-xp-earned">0</dd>
      </div>
      <div class="result-item result-item--wide">
        <dt translate="no">MISSIONS COMPLETED</dt>
        <dd id="final-missions-completed">0</dd>
      </div>
      <div class="result-item result-item--wide">
        <dt translate="no">ACHIEVEMENTS UNLOCKED</dt>
        <dd id="final-achievements-unlocked">0</dd>
      </div>
    </dl>

    <div class="next-goal" id="next-goal" hidden>
      <p class="eyebrow next-goal-label" translate="no">NEXT GOAL</p>
      <p class="next-goal-text" id="next-goal-text"></p>
    </div>

    <div class="result-actions">
      <button class="btn-pill btn-pill--primary" id="restart-button">
        <span>Play again</span><kbd class="keycap" translate="no">R</kbd>
      </button>
      <button class="btn-pill btn-pill--secondary" id="copy-button" type="button" hidden>
        <span id="copy-button-label">Copy result</span>
      </button>
      <button class="btn-pill btn-pill--secondary" id="share-button" type="button">
        <span id="share-button-label">Share score</span>
      </button>
      <button class="btn-pill btn-pill--secondary" id="challenge-share-button" type="button" hidden>
        <span>Create challenge</span>
      </button>
    </div>
  </div>

  <div class="fs-controls" role="group" aria-label="Fullscreen controls">
    <button class="btn-pill fs-btn" id="fs-pause" type="button">
      <span class="fs-btn-icon" aria-hidden="true">Ⅱ</span>
      <span id="fs-pause-label" translate="no">PAUSE</span>
    </button>
    <button class="btn-pill fs-btn" id="fs-sound" type="button" aria-pressed="false">
      <span id="fs-sound-label" translate="no">SOUND ON</span>
    </button>
    <button class="btn-pill fs-btn" id="fs-exit" type="button">
      <svg class="fs-btn-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2v4H2M10 2v4h4M6 14v-4H2M10 14v-4h4" />
      </svg>
      <span translate="no">EXIT</span>
    </button>
  </div>
</section>

<script>
  import { mountGame } from '../game/game';
  mountGame();
</script>

<style>
  .game-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-canvas);
  }

  .game-stage::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03),
      inset 0 0 60px rgba(0, 0, 0, 0.45);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .scanline {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.05;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, transparent, transparent 3px, #ffffff 4px);
    mix-blend-mode: overlay;
  }

  .board-corner {
    position: absolute;
    z-index: 3;
    width: 18px;
    height: 18px;
    border-color: rgba(255, 255, 255, 0.45);
    opacity: 0.8;
    pointer-events: none;
  }

  .corner-tl {
    top: 10px;
    left: 10px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .corner-tr {
    top: 10px;
    right: 10px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .corner-bl {
    bottom: 10px;
    left: 10px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .corner-br {
    right: 10px;
    bottom: 10px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
    background: radial-gradient(circle at center, rgba(26, 28, 32, 0.7), rgba(10, 10, 10, 0.88));
    backdrop-filter: blur(4px);
    transition: opacity 0.3s ease;
  }

  /* Fade out, then drop from layout/a11y/focus order. Visibility snaps on
     when showing so the overlay (and its buttons) are immediately
     focusable/announceable — a discrete visibility transition would otherwise
     keep the overlay hidden for the first half of the fade-in. */
  .game-overlay.hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  .overlay-glow {
    width: 54px;
    height: 54px;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 214, 168, 0.7);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #fff7ed, #ffc285 22%, #ff7a17 46%, #7c3aed 74%, transparent 78%);
    box-shadow:
      0 0 20px 8px rgba(255, 122, 23, 0.35),
      0 0 64px 24px rgba(124, 58, 237, 0.18);
    animation: float 2.7s ease-in-out infinite;
  }

  .overlay-kicker {
    color: rgba(255, 255, 255, 0.6);
  }

  .overlay-kicker.failure {
    color: var(--color-twilight);
  }

  .result-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 14px 0 18px;
  }

  .result-score-label {
    color: rgba(255, 255, 255, 0.45);
  }

  .result-score-value {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: clamp(44px, 8vw, 64px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  .result-new-best {
    display: none;
    margin-top: 6px;
    padding: 3px 12px;
    border: 1px solid rgba(255, 122, 23, 0.6);
    border-radius: 9999px;
    color: var(--color-sunset-soft);
    background: rgba(255, 122, 23, 0.1);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    box-shadow: 0 0 14px rgba(255, 122, 23, 0.35);
  }

  .result-new-best.is-new-best {
    display: inline-block;
  }

  .result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: min(320px, 100%);
    margin: 0 0 22px;
  }

  .result-item {
    padding: 8px 10px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.02);
  }

  /* The mode's record length spans the whole grid as a wide strip. */
  .result-item--wide {
    grid-column: 1 / -1;
  }

  .result-item dt {
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .result-item dd {
    margin: 4px 0 0;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .result-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }

  .btn-pill--secondary {
    border-color: rgba(255, 122, 23, 0.5);
    color: var(--color-sunset-soft);
  }

  .btn-pill--secondary:hover:not(:disabled) {
    border-color: var(--color-sunset);
  }

  .btn-pill[hidden] {
    display: none;
  }

  /* Secondary "Play fullscreen" CTA on the start screen. */
  .start-fs-button {
    margin-top: 10px;
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* Floating controls that appear only in fullscreen mode (display toggled
     globally via body.is-fullscreen). */
  .fs-controls {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 7;
    display: none;
    align-items: center;
    gap: 8px;
  }

  .fs-btn {
    min-height: 40px;
    padding: 6px 14px;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(3px);
  }

  .fs-btn-icon {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--color-sunset);
  }

  .fs-btn .fs-btn-icon:first-child {
    font-size: 14px;
    line-height: 1;
  }

  h2 {
    margin: 10px 0 10px;
    font-size: clamp(30px, 4vw, 42px);
  }

  .overlay-text {
    max-width: 340px;
    margin: 0 0 28px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Mode-specific rule line shown on the start screen (set by the engine). */
  .overlay-note {
    max-width: 320px;
    margin: -16px 0 22px;
    color: var(--color-sunset-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    text-wrap: pretty;
  }

  /* Mode-specific stat line (time target, wrap reminder, daily progress). */
  .overlay-mode-info {
    margin: -10px 0 20px;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-wrap: pretty;
  }

  /* Persistent player progression line (rank + XP). */
  .overlay-rank {
    margin: -10px 0 20px;
    color: var(--color-sunset-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Compact mission list (difficulty tag, title, live progress bar). Only the
     start screen shows it; the board itself stays clean. */
  .missions-panel {
    width: min(300px, 100%);
    margin: -6px 0 18px;
    text-align: left;
  }

  .missions-panel[hidden] {
    display: none;
  }

  .missions-heading {
    display: block;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.18em;
  }

  .missions-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .mission-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 4px 8px;
    padding: 5px 10px;
    border: 1px solid var(--color-hairline);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.03);
  }

  .mission-tag {
    padding: 2px 7px;
    border: 1px solid currentColor;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.14em;
  }

  .diff-easy {
    color: #7fd8a4;
  }

  .diff-medium {
    color: var(--color-sunset-soft);
  }

  .diff-hard {
    color: var(--color-sunset);
  }

  .diff-master {
    color: #c4b5fd;
  }

  .mission-title {
    overflow: hidden;
    color: var(--color-body);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mission-count {
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .mission-bar {
    grid-column: 1 / -1;
    height: 3px;
    overflow: hidden;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
  }

  .mission-bar-fill {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, var(--color-sunset), #c4b5fd);
    transition: width 0.3s ease;
  }

  .mission-row.is-complete .mission-bar-fill {
    background: linear-gradient(90deg, #7fd8a4, #c4b5fd);
  }

  .mission-row.is-complete .mission-count {
    color: #7fd8a4;
  }

  /* Transient, non-blocking mission-complete confirmation over the board. */
  .mission-toast {
    position: absolute;
    top: 64px;
    left: 50%;
    z-index: 6;
    padding: 8px 16px;
    border: 1px solid rgba(124, 58, 237, 0.55);
    border-radius: 9999px;
    background: rgba(10, 10, 10, 0.85);
    color: #e9d5ff;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0;
    transform: translate(-50%, -6px);
    pointer-events: none;
    backdrop-filter: blur(3px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .mission-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Achievement unlocks: same restrained toast, offset below the mission one
     and tinted with the dusk accent so the two never look like the same event. */
  .achievement-toast {
    top: 116px;
    border-color: rgba(196, 165, 253, 0.55);
    color: #e9d5ff;
  }

  .mission-toast[hidden] {
    display: none;
  }

  /* Event banner (Session 6): persistent while an event is active, shows
     event label and countdown. Positioned below mode badge, above toasts. */
  .event-banner {
    position: absolute;
    top: 40px;
    left: 50%;
    z-index: 6;
    padding: 4px 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 9999px;
    background: rgba(10, 10, 10, 0.78);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
    transform: translateX(-50%);
    backdrop-filter: blur(3px);
    pointer-events: none;
    user-select: none;
  }
  .event-banner[hidden] {
    display: none;
  }
  .event-banner.is-visible {
    animation: event-pop 0.3s ease;
  }
  .event-banner.event-gold-rush {
    border-color: rgba(250, 204, 21, 0.6);
    color: #fde047;
  }
  .event-banner.event-blood-moon {
    border-color: rgba(248, 113, 113, 0.6);
    color: #fca5a5;
  }
  .event-banner.event-safe-zone {
    border-color: rgba(127, 216, 164, 0.6);
    color: #7fd8a4;
  }

  @keyframes event-pop {
    0% {
      transform: translateX(-50%) scale(0.9);
      opacity: 0;
    }
    100% {
      transform: translateX(-50%) scale(1);
      opacity: 1;
    }
  }

  /* Event board ring (Session 6): subtle colored inset border on the stage
     while an event is active — a peripheral cue without animation. */
  .game-stage.event-active::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-card);
    pointer-events: none;
  }
  .game-stage.event-gold-rush::after {
    border-color: rgba(250, 204, 21, 0.45);
  }
  .game-stage.event-blood-moon::after {
    border-color: rgba(248, 113, 113, 0.45);
  }
  .game-stage.event-safe-zone::after {
    border-color: rgba(127, 216, 164, 0.45);
  }

  /* Floating score feedback over the board (Session 4): small transient
     popups anchored to board cells, purely decorative and non-blocking. */
  .score-popups {
    position: absolute;
    inset: 0;
    z-index: 4;
    overflow: hidden;
    pointer-events: none;
  }

  .score-popup {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
