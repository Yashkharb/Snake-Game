---
---
<header class="topbar">
  <a class="brand" href="." aria-label="Serpent home">
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span translate="no">SERPENT</span>
  </a>
  <div class="topbar-right">
    <span class="live-dot" aria-hidden="true"></span>
    <span class="system-label" translate="no">ARCADE PROTOCOL</span>
  </div>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: calc(env(safe-area-inset-top, 0px) + 20px);
    padding-block-end: 26px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-ink);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-decoration: none;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    gap: 3px;
    width: 24px;
    height: 18px;
    transform: skewX(-19deg);
  }

  .brand-mark i {
    width: 5px;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(180deg, #ffffff, #ffc285);
  }

  .brand-mark i:nth-child(2) {
    height: 66%;
    opacity: 0.75;
  }

  .brand-mark i:nth-child(3) {
    height: 36%;
    opacity: 0.45;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-sunset);
    box-shadow: 0 0 10px var(--color-sunset);
    animation: breathe 2.2s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      opacity: 0.35;
      box-shadow: 0 0 2px var(--color-sunset);
    }
  }

  @media (max-width: 380px) {
    .system-label {
      display: none;
    }
  }
</style>