---
---
<section class="hero" aria-labelledby="game-title">
  <p class="eyebrow hero-eyebrow">THE CLASSIC SNAKE GAME</p>
  <h1 id="game-title" class="display-tight">
    Play <em>Snake Game</em> online.
  </h1>
  <p class="subtitle">
    The classic arcade game, sharpened for your browser. Steer the snake, collect the fruit, grow
    longer — and don't hit the wall or your own tail.
  </p>
</section>

<style>
  .hero {
    max-width: 620px;
    margin: 0 auto 46px;
    padding-left: 12.5%;
  }

  .hero-eyebrow {
    color: rgba(255, 255, 255, 0.55);
  }

  h1 {
    margin: 14px 0 16px;
    font-size: clamp(42px, 6.4vw, 86px);
    letter-spacing: -0.055em;
  }

  h1 em {
    color: var(--color-sunset);
    font-style: normal;
  }

  .subtitle {
    max-width: 460px;
    margin: 0;
    color: var(--color-mute);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .hero {
      padding-left: 0;
      margin-bottom: 14px;
    }
    .hero-eyebrow {
      font-size: 10px;
    }
    h1 {
      margin: 10px 0 12px;
      font-size: 34px;
    }
    .subtitle {
      font-size: 14px;
      line-height: 1.5;
    }
  }

  /* Reclaim vertical space once a run is in progress: on small widths (mobile)
     and on short viewports (laptop/tablet landscape) the game board + controls
     get priority over the marketing copy. */
  @media (max-width: 700px), (max-height: 1020px) {
    :global(body.is-playing) .hero {
      display: none;
    }
  }

  /* Very narrow portrait phones: compact the hero so the Start button stays
     above the fold. */
  @media (max-width: 360px) {
    .hero {
      margin-bottom: 18px;
    }
    h1 {
      margin: 10px 0 12px;
      font-size: 30px;
    }
    .subtitle {
      font-size: 14px;
      line-height: 1.5;
    }
  }

  /* Short landscape: marketing copy never fights the board for space. */
  @media (max-height: 600px) and (orientation: landscape) and (max-width: 1020px) {
    .hero {
      display: none;
    }
  }
</style>