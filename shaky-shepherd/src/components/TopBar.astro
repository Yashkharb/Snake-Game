---
---
<header class="topbar">
  <a class="brand" href="." aria-label="Snake Game home">
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>Snake Game</span>
  </a>
  <div class="topbar-right">
    <a class="how-link" href="#how-to-play">How to play</a>
  </div>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: calc(env(safe-area-inset-top, 0px) + 20px);
    padding-block-end: 26px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-ink);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    gap: 3px;
    width: 24px;
    height: 18px;
    transform: skewX(-19deg);
  }

  .brand-mark i {
    width: 5px;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(180deg, #ffffff, #ffc285);
  }

  .brand-mark i:nth-child(2) {
    height: 66%;
    opacity: 0.75;
  }

  .brand-mark i:nth-child(3) {
    height: 36%;
    opacity: 0.45;
  }

  .topbar-right {
    display: flex;
    align-items: center;
  }

  .how-link {
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .how-link:hover {
    color: var(--color-ink);
  }
</style>