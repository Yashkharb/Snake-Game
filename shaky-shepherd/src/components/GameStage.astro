---
---
<section class="game-stage" id="game-stage" tabindex="-1" aria-label="Snake game board">
  <div class="board-corner corner-tl" aria-hidden="true"></div>
  <div class="board-corner corner-tr" aria-hidden="true"></div>
  <div class="board-corner corner-bl" aria-hidden="true"></div>
  <div class="board-corner corner-br" aria-hidden="true"></div>

  <canvas id="game-board" aria-label="Snake game board"></canvas>
  <span class="mode-badge" id="mode-badge" translate="no">CLASSIC</span>
  <div class="scanline" aria-hidden="true"></div>
  <div class="visually-hidden" id="status-announcer" role="status" aria-live="polite"></div>

  <div class="game-overlay" id="start-overlay">
    <div class="overlay-glow" aria-hidden="true"></div>
    <p class="eyebrow overlay-kicker" id="start-kicker">GET READY</p>
    <h2 class="display-tight" id="start-title">Ready to play?</h2>
    <p class="overlay-date" id="daily-date" hidden></p>
    <p class="overlay-text">
      Steer the snake with the arrow keys, WASD, or a swipe. Collect the fruit to grow.
    </p>
    <p class="overlay-note" id="start-mode-note">
      Standard Snake rules: eat fruit, grow, and don't hit the wall or your own tail.
    </p>
    <p class="overlay-mode-info" id="start-mode-info" translate="no"></p>
    <p class="overlay-best" id="daily-best" hidden></p>
    <p class="overlay-streak" id="daily-streak" hidden></p>
    <button class="btn-pill btn-pill--primary" id="start-button">
      <span id="start-button-label">Start run</span><kbd class="keycap">Space</kbd>
    </button>
    <p class="control-hint"><span>ARROW KEYS · WASD · SWIPE OR DIRECTION PAD</span></p>
  </div>

  <div class="game-overlay hidden" id="pause-overlay">
    <p class="eyebrow overlay-kicker">PAUSED</p>
    <h2 class="display-tight">Paused</h2>
    <p class="overlay-text">Take a breath — you can pick up right where you left off.</p>
    <button class="btn-pill btn-pill--primary" id="resume-button">
      <span>Resume run</span><kbd class="keycap">Space</kbd>
    </button>
  </div>

  <div class="game-overlay hidden" id="gameover-overlay" role="dialog" aria-labelledby="gameover-title" aria-describedby="gameover-kicker">
    <p class="eyebrow overlay-kicker" id="gameover-kicker">RUN OVER</p>
    <h2 class="display-tight" id="gameover-title">You hit the wall.</h2>

    <div class="result-score">
      <span class="eyebrow result-score-label" translate="no">SCORE</span>
      <strong id="final-score" class="result-score-value">000</strong>
      <span class="result-new-best" id="new-best-badge" translate="no">NEW BEST</span>
    </div>

    <dl class="result-grid" aria-label="Run results">
      <div class="result-item">
        <dt translate="no">BEST</dt>
        <dd id="final-best">000</dd>
      </div>
      <div class="result-item">
        <dt translate="no">LEVEL</dt>
        <dd id="final-level">01</dd>
      </div>
      <div class="result-item">
        <dt translate="no">LENGTH</dt>
        <dd id="final-length">4</dd>
      </div>
      <div class="result-item">
        <dt translate="no">LONGEST</dt>
        <dd id="final-longest">4</dd>
      </div>
      <div class="result-item">
        <dt translate="no">FRUIT</dt>
        <dd id="final-fruit">0</dd>
      </div>
      <div class="result-item">
        <dt translate="no">TIME</dt>
        <dd id="final-duration">0:00</dd>
      </div>
      <div class="result-item result-item--wide">
        <dt translate="no">BEST LENGTH</dt>
        <dd id="final-record">4</dd>
      </div>
    </dl>

    <div class="result-actions">
      <button class="btn-pill btn-pill--primary" id="restart-button">
        <span>Play again</span><kbd class="keycap" translate="no">R</kbd>
      </button>
      <button class="btn-pill btn-pill--secondary" id="copy-button" type="button" hidden>
        <span id="copy-button-label">Copy result</span>
      </button>
      <button class="btn-pill btn-pill--secondary" id="share-button" type="button">
        <span id="share-button-label">Share score</span>
      </button>
    </div>
  </div>
</section>

<script>
  import { mountGame } from '../game/game';
  mountGame();
</script>

<style>
  .game-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-canvas);
  }

  .game-stage::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03),
      inset 0 0 60px rgba(0, 0, 0, 0.45);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .scanline {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.05;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, transparent, transparent 3px, #ffffff 4px);
    mix-blend-mode: overlay;
  }

  .board-corner {
    position: absolute;
    z-index: 3;
    width: 18px;
    height: 18px;
    border-color: rgba(255, 255, 255, 0.45);
    opacity: 0.8;
    pointer-events: none;
  }

  .corner-tl {
    top: 10px;
    left: 10px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .corner-tr {
    top: 10px;
    right: 10px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .corner-bl {
    bottom: 10px;
    left: 10px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .corner-br {
    right: 10px;
    bottom: 10px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
    background: radial-gradient(circle at center, rgba(26, 28, 32, 0.7), rgba(10, 10, 10, 0.88));
    backdrop-filter: blur(4px);
    transition: opacity 0.3s ease;
  }

  /* Fade out, then drop from layout/a11y/focus order. Visibility snaps on
     when showing so the overlay (and its buttons) are immediately
     focusable/announceable — a discrete visibility transition would otherwise
     keep the overlay hidden for the first half of the fade-in. */
  .game-overlay.hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  .overlay-glow {
    width: 54px;
    height: 54px;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 214, 168, 0.7);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #fff7ed, #ffc285 22%, #ff7a17 46%, #7c3aed 74%, transparent 78%);
    box-shadow:
      0 0 20px 8px rgba(255, 122, 23, 0.35),
      0 0 64px 24px rgba(124, 58, 237, 0.18);
    animation: float 2.7s ease-in-out infinite;
  }

  .overlay-kicker {
    color: rgba(255, 255, 255, 0.6);
  }

  .overlay-kicker.failure {
    color: var(--color-twilight);
  }

  .result-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 14px 0 18px;
  }

  .result-score-label {
    color: rgba(255, 255, 255, 0.45);
  }

  .result-score-value {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: clamp(44px, 8vw, 64px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  .result-new-best {
    display: none;
    margin-top: 6px;
    padding: 3px 12px;
    border: 1px solid rgba(255, 122, 23, 0.6);
    border-radius: 9999px;
    color: var(--color-sunset-soft);
    background: rgba(255, 122, 23, 0.1);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    box-shadow: 0 0 14px rgba(255, 122, 23, 0.35);
  }

  .result-new-best.is-new-best {
    display: inline-block;
  }

  .result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: min(320px, 100%);
    margin: 0 0 22px;
  }

  .result-item {
    padding: 8px 10px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.02);
  }

  /* The mode's record length spans the whole grid as a wide strip. */
  .result-item--wide {
    grid-column: 1 / -1;
  }

  .result-item dt {
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .result-item dd {
    margin: 4px 0 0;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .result-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }

  .btn-pill--secondary {
    border-color: rgba(255, 122, 23, 0.5);
    color: var(--color-sunset-soft);
  }

  .btn-pill--secondary:hover:not(:disabled) {
    border-color: var(--color-sunset);
  }

  .btn-pill[hidden] {
    display: none;
  }

  h2 {
    margin: 10px 0 10px;
    font-size: clamp(30px, 4vw, 42px);
  }

  .overlay-text {
    max-width: 340px;
    margin: 0 0 28px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Mode-specific rule line shown on the start screen (set by the engine). */
  .overlay-note {
    max-width: 320px;
    margin: -16px 0 22px;
    color: var(--color-sunset-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    text-wrap: pretty;
  }

  /* Mode-specific stat line (time target, wrap reminder, daily progress). */
  .overlay-mode-info {
    margin: -10px 0 20px;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-wrap: pretty;
  }

  /* Daily Challenge identity lines (date + best) — visible only in daily mode.
     The [hidden] selector outranks the .is-daily display rule, so a stale
     hidden attribute always wins. */
  .overlay-date,
  .overlay-best {
    margin: 0;
    color: var(--color-sunset-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .game-overlay.is-daily .overlay-date[hidden],
  .game-overlay.is-daily .overlay-best[hidden] {
    display: none;
  }

  .game-overlay.is-daily .overlay-text {
    display: none;
  }

  .game-overlay.is-daily .overlay-date {
    display: block;
    margin: -6px 0 14px;
    color: var(--color-ink);
  }

  .game-overlay.is-daily .overlay-note {
    margin: 0 0 12px;
  }

  .game-overlay.is-daily .overlay-mode-info {
    margin: -6px 0 14px;
  }

  .game-overlay.is-daily .overlay-best {
    display: block;
    margin: 0 0 14px;
    color: var(--color-sunset);
  }

  /* Current completion streak, only shown for the Daily challenge. */
  .overlay-streak {
    display: none;
    margin: -8px 0 22px;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .game-overlay.is-daily .overlay-streak {
    display: block;
  }

  .game-overlay.is-daily .overlay-streak[hidden] {
    display: none;
  }

  /* Persistent mode indicator, on top of every overlay (incl. results). */
  .mode-badge {
    position: absolute;
    top: 10px;
    left: 50%;
    z-index: 6;
    padding: 4px 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    background: rgba(10, 10, 10, 0.72);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    backdrop-filter: blur(3px);
    pointer-events: none;
    user-select: none;
    transform: translateX(-50%);
  }

  .control-hint {
    margin: 18px 0 0;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .control-hint span {
    color: var(--color-body);
  }

  @keyframes float {
    50% {
      transform: translateY(-5px) scale(1.04);
    }
  }

  /* Small portrait boards: keep the overlay inside the square. */
  @media (max-width: 480px) {
    .game-overlay {
      padding: 18px;
    }
    /* The Daily Challenge screen reads as a card: top-align it so the Play
       challenge CTA stays above the fold on small portrait phones. */
    .game-overlay.is-daily {
      justify-content: flex-start;
      padding-top: 18px;
    }
    .overlay-glow {
      width: 34px;
      height: 34px;
      margin-bottom: 12px;
    }
    h2 {
      margin: 8px 0;
      font-size: 26px;
    }
    .overlay-text {
      margin-bottom: 18px;
      font-size: 13px;
    }
    .overlay-note {
      margin: -14px 0 14px;
      font-size: 10px;
    }
    .overlay-mode-info {
      margin: -8px 0 12px;
      font-size: 9px;
    }
    .game-overlay.is-daily .overlay-date {
      margin: -4px 0 8px;
    }
    .game-overlay.is-daily .overlay-note {
      margin: 0 0 6px;
    }
    .game-overlay.is-daily .overlay-best {
      margin: 0 0 10px;
    }
    .game-overlay.is-daily .overlay-streak {
      margin: -6px 0 12px;
    }
    .overlay-date,
    .overlay-best {
      font-size: 10px;
    }
    .control-hint {
      display: none;
    }
    .result-score {
      margin: 10px 0 12px;
    }
    .result-score-value {
      font-size: 40px;
    }
    .result-grid {
      gap: 4px;
      margin-bottom: 14px;
    }
    .result-item {
      padding: 6px 8px;
    }
    .result-item dd {
      font-size: 13px;
    }
    .result-actions {
      flex-direction: column-reverse;
      gap: 8px;
      width: 100%;
    }
    .result-actions .btn-pill {
      width: 100%;
    }
  }

  /* Small portrait screens: roomy primary-action touch targets. */
  @media (max-width: 700px) {
    .btn-pill--primary,
    .btn-pill--secondary {
      min-height: 52px;
    }
  }

  /* Landscape phones: the board is short, trim the overlay hard. */
  @media (max-height: 600px) and (orientation: landscape) {
    .game-overlay {
      padding: 12px;
    }
    .overlay-glow {
      width: 26px;
      height: 26px;
      margin-bottom: 8px;
    }
    h2 {
      margin: 6px 0;
      font-size: 24px;
    }
    .overlay-text,
    .overlay-note,
    .overlay-mode-info,
    .overlay-date,
    .overlay-best,
    .overlay-streak,
    .control-hint,
    .result-grid {
      display: none;
    }
    .result-score {
      margin: 8px 0 12px;
    }
    .result-score-value {
      font-size: 34px;
    }
    .result-actions {
      flex-wrap: wrap;
      gap: 8px;
    }
    .result-actions .btn-pill {
      min-height: 36px;
      padding: 6px 12px;
      font-size: 12px;
    }
  }
</style>