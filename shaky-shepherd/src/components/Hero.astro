<section class="hero" aria-labelledby="game-title">
  <p class="eyebrow hero-eyebrow">THE CLASSIC SNAKE GAME</p>
  <h1 id="game-title" class="display-tight">
    Play <em>Snake Game</em> online.
  </h1>
  <p class="subtitle">
    The classic snake game, reborn. Thread your way through a dark digital garden, eat every solar
    fruit, and never touch the perimeter — or yourself.
  </p>
</section>

<style>
  .hero {
    max-width: 620px;
    margin: 0 auto 46px;
    padding-left: 12.5%;
  }

  .hero-eyebrow {
    color: rgba(255, 255, 255, 0.55);
  }

  h1 {
    margin: 14px 0 16px;
    font-size: clamp(42px, 6.4vw, 86px);
    letter-spacing: -0.055em;
  }

  h1 em {
    color: var(--color-sunset);
    font-style: normal;
  }

  .subtitle {
    max-width: 460px;
    margin: 0;
    color: var(--color-mute);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>