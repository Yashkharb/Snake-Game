---
const base = import.meta.env.BASE_URL;
---
<footer>
  <span>© 2026 Snake Game · Built by yashkharb</span>
  <nav class="footer-links" aria-label="Site pages">
    <a href={base + 'about/'}>About</a>
    <a href={base + 'privacy/'}>Privacy</a>
    <a href={base + 'terms/'}>Terms</a>
    <a href={base + 'contact/'}>Contact</a>
  </nav>
  <span>Free to play — no account needed</span>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 26px;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .footer-links a {
    color: var(--color-mute);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .footer-links a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    footer {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-align: center;
    }
    .footer-links {
      justify-content: center;
    }
  }

  /* Short landscape: the footer never fights the board for space. */
  @media (max-height: 600px) and (orientation: landscape) and (max-width: 1020px) {
    footer {
      display: none;
    }
  }
</style>