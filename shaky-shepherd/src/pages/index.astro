---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import StatRail from '../components/StatRail.astro';
import ModePicker from '../components/ModePicker.astro';
import GameStage from '../components/GameStage.astro';
import TouchControls from '../components/TouchControls.astro';
import InfoRail from '../components/InfoRail.astro';
import SeoContent from '../components/SeoContent.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  <main class="app-shell">
    <TopBar />
    <Hero />

    <section class="game-layout" aria-label="Snake game">
      <StatRail />
      <div class="board-column">
        <ModePicker />
        <GameStage />
        <TouchControls />
      </div>
      <InfoRail />
    </section>

    <SeoContent />
    <SiteFooter />
  </main>
</Layout>

<style>
  .app-shell {
    position: relative;
    width: min(1240px, 100%);
    min-height: 100vh;
    margin: 0 auto;
    padding-top: env(safe-area-inset-top, 0px);
    padding-right: max(env(safe-area-inset-right, 0px), clamp(20px, 4vw, 64px));
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 40px);
    padding-left: max(env(safe-area-inset-left, 0px), clamp(20px, 4vw, 64px));
  }

  .game-layout {
    display: grid;
    grid-template-columns: 180px minmax(360px, 620px) 180px;
    gap: clamp(16px, 2vw, 28px);
    align-items: center;
    justify-content: center;
  }

  .board-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  /* The page owns the game-layout grid and the placement of the three grid
     columns (stat rail, board column, info rail). Each rail's internal
     responsive rules live in its own component (StatRail.astro,
     InfoRail.astro, Hero.astro, TouchControls.astro) so they can be applied
     with normal scoped specificity instead of fighting :global() overrides. */

  @media (max-width: 1020px) {
    .game-layout {
      grid-template-columns: 150px minmax(340px, 560px);
    }
    :global(.info-rail) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .app-shell {
      padding-top: env(safe-area-inset-top, 0px);
      padding-right: max(14px, env(safe-area-inset-right, 0px));
      padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
      padding-left: max(14px, env(safe-area-inset-left, 0px));
    }
    .game-layout {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .board-column {
      gap: 10px;
    }
  }

  /* Short landscape: three-column arcade layout with slim side rails.
     The board column flexes up to 72vh so it stays fully on screen. */
  @media (max-height: 600px) and (orientation: landscape) and (max-width: 1020px) {
    .app-shell {
      padding-top: env(safe-area-inset-top, 0px);
      padding-right: max(14px, env(safe-area-inset-right, 0px));
      padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      padding-left: max(14px, env(safe-area-inset-left, 0px));
    }
    .game-layout {
      grid-template-columns: 110px minmax(180px, min(72vh, calc(100vw - 320px))) 130px;
      gap: 10px;
    }
    :global(.stat-rail) {
      grid-column: 1;
      grid-row: 1;
    }
    .board-column {
      grid-column: 2;
      grid-row: 1;
    }
    :global(.info-rail) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>