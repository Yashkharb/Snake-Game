---
---
<section class="game-stage" id="game-stage" tabindex="-1" aria-label="Snake game board">
  <div class="board-corner corner-tl" aria-hidden="true"></div>
  <div class="board-corner corner-tr" aria-hidden="true"></div>
  <div class="board-corner corner-bl" aria-hidden="true"></div>
  <div class="board-corner corner-br" aria-hidden="true"></div>

  <canvas id="game-board" aria-label="Snake game board"></canvas>
  <div class="scanline" aria-hidden="true"></div>

  <div class="game-overlay" id="start-overlay">
    <div class="overlay-orb" aria-hidden="true"></div>
    <p class="eyebrow overlay-kicker" translate="no">SYSTEM READY</p>
    <h2 class="display-tight">Enter the garden</h2>
    <p class="overlay-text">
      Guide the serpent with the direction pad or a swipe. Collect solar fruit. Never touch the
      perimeter — or yourself.
    </p>
    <button class="btn-pill btn-pill--primary" id="start-button">
      <span>Start run</span><kbd class="keycap" translate="no">Space</kbd>
    </button>
    <p class="control-hint" translate="no"><span>SWIPE OR USE THE DIRECTION PAD</span></p>
  </div>

  <div class="game-overlay hidden" id="pause-overlay">
    <p class="eyebrow overlay-kicker" translate="no">SIGNAL HELD</p>
    <h2 class="display-tight">Paused</h2>
    <p class="overlay-text">Take a breath. The garden is holding its pulse.</p>
    <button class="btn-pill btn-pill--primary" id="resume-button">
      <span>Resume run</span><kbd class="keycap" translate="no">Space</kbd>
    </button>
  </div>

  <div class="game-overlay hidden" id="gameover-overlay">
    <p class="eyebrow overlay-kicker failure" translate="no">RUN TERMINATED</p>
    <h2 class="display-tight">Beautiful chaos.</h2>
    <p class="overlay-text" id="gameover-message" aria-live="polite"></p>
    <button class="btn-pill btn-pill--primary" id="restart-button">
      <span>Run it back</span><kbd class="keycap" translate="no">R</kbd>
    </button>
  </div>
</section>

<script>
  import { mountGame } from '../game/game';
  mountGame();
</script>

<style>
  .game-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-canvas);
  }

  .game-stage::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03),
      inset 0 0 60px rgba(0, 0, 0, 0.45);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .scanline {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.05;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, transparent, transparent 3px, #ffffff 4px);
    mix-blend-mode: overlay;
  }

  .board-corner {
    position: absolute;
    z-index: 3;
    width: 18px;
    height: 18px;
    border-color: rgba(255, 255, 255, 0.45);
    opacity: 0.8;
    pointer-events: none;
  }

  .corner-tl {
    top: 10px;
    left: 10px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .corner-tr {
    top: 10px;
    right: 10px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .corner-bl {
    bottom: 10px;
    left: 10px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .corner-br {
    right: 10px;
    bottom: 10px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
    background: radial-gradient(circle at center, rgba(26, 28, 32, 0.7), rgba(10, 10, 10, 0.88));
    backdrop-filter: blur(4px);
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .game-overlay.hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .overlay-orb {
    width: 54px;
    height: 54px;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 214, 168, 0.7);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #fff7ed, #ffc285 22%, #ff7a17 46%, #7c3aed 74%, transparent 78%);
    box-shadow:
      0 0 20px 8px rgba(255, 122, 23, 0.35),
      0 0 64px 24px rgba(124, 58, 237, 0.18);
    animation: float 2.7s ease-in-out infinite;
  }

  .overlay-kicker {
    color: rgba(255, 255, 255, 0.6);
  }

  .overlay-kicker.failure {
    color: var(--color-twilight);
  }

  h2 {
    margin: 10px 0 10px;
    font-size: clamp(30px, 4vw, 42px);
  }

  .overlay-text {
    max-width: 340px;
    margin: 0 0 28px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .control-hint {
    margin: 18px 0 0;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .control-hint span {
    color: var(--color-body);
  }

  @keyframes float {
    50% {
      transform: translateY(-5px) scale(1.04);
    }
  }

  /* Small portrait boards: keep the overlay inside the square. */
  @media (max-width: 480px) {
    .game-overlay {
      padding: 18px;
    }
    .overlay-orb {
      width: 34px;
      height: 34px;
      margin-bottom: 12px;
    }
    h2 {
      margin: 8px 0;
      font-size: 26px;
    }
    .overlay-text {
      margin-bottom: 18px;
      font-size: 13px;
    }
    .control-hint {
      display: none;
    }
  }

  /* Landscape phones: the board is short, trim the overlay hard. */
  @media (max-height: 600px) and (orientation: landscape) {
    .game-overlay {
      padding: 12px;
    }
    .overlay-orb {
      width: 26px;
      height: 26px;
      margin-bottom: 8px;
    }
    h2 {
      margin: 6px 0;
      font-size: 24px;
    }
    .overlay-text,
    .control-hint {
      display: none;
    }
  }
</style>